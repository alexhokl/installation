#!/bin/bash

install_vscode_extensions() {
  if ! command -v code &> /dev/null; then
    echo "VSCode is not installed. Skipping VSCode extensions and settings installation."
    return
  fi
  if [ -f $HOME/git/installation/vscode-extensions.txt ]; then
    cat $HOME/git/installation/vscode-extensions.txt | xargs -n 1 code --force --install-extension
  else
    echo "File [vscode-extensions.txt] not found. Skipping VSCode extensions installation."
  fi
  if [ ! -f $HOME/git/installation/vscode_settings.json ]; then
    echo "File [vscode_settings.json] not found. Skipping VSCode settings installation."
    return
  fi
  if [ "$(uname)" == "Darwin" ]; then
    _SETTINGS_DIR="$HOME/Library/Application Support/Code/User"
  else
    _SETTINGS_DIR=$HOME/.config/Code/User
  fi
  mkdir -p "$_SETTINGS_DIR"
  /bin/cp -f $HOME/git/installation/vscode_settings.json "$_SETTINGS_DIR/settings.json"
}

install_dotnet_tools() {
  cat $HOME/git/installation/dotnet_tools | xargs -n 1 dotnet tool install -g
}

install_gh_extensions() {
  cat $HOME/git/installation/gh_extensions | xargs -n 1 gh extension install
}

install_cargo_packages() {
  cat $HOME/git/installation/cargo_packages | xargs -n 1 cargo install
  cat $HOME/git/installation/cargo_git_packages | xargs -n 1 cargo install --git
}

install_go_packages() {
  cat $HOME/git/installation/go_packages | xargs -n 1 go install
}

update_npm_packages() {
  cat $HOME/git/installation/npm-list.txt | xargs -n 1 npm install -g
}

install_npx_skills() {
  cat $HOME/git/installation/npx_skills | xargs -n 1 npx skills add -y --agent opencode --agent claude-code -g
}

update_python_packages() {
  python -m pip install --upgrade --user pip
  python -m pip install --upgrade --user -r $HOME/git/installation/requirements.txt
}

install_gcloud_components() {
  cat $HOME/git/installation/gcloud_components | xargs -n 1 gcloud components install -q
}

install_gcpdiag() {
  sudo curl -o /usr/local/bin/gcpdiag -sSL https://gcpdiag.dev/gcpdiag.sh
  sudo chmod +x /usr/local/bin/gcpdiag
}

install_flutter() {
  pushd $PWD

  _REPO_DIR=$HOME/git/flutter
  if [ -d $_REPO_DIR ]; then
    rm -rf $_REPO_DIR
  fi
  git clone https://github.com/flutter/flutter.git $_REPO_DIR
  cd $_REPO_DIR
  git checkout stable

  popd
}

install_slack_cli() {
  curl -fsSL https://downloads.slack-edge.com/slack-cli/install.sh | bash -s slack-cli
}

install_sc_im() {
  pushd $PWD

  _DIR=$HOME/git/libxlsxwriter
  if [ ! -d "$_DIR" ]; then
    git clone https://github.com/jmcnamara/libxlsxwriter.git $_DIR
    cd $_DIR
  else
    cd $_DIR
    git pull
  fi
  make
  sudo make install

  _DIR=$HOME/git/sc-im
  if [ ! -d "$_DIR" ]; then
    git clone https://github.com/andmarti1424/sc-im.git $_DIR
    cd $_DIR
  else
    cd $_DIR
    git pull
  fi
  # Makefile lives in src/, not the repository root
  make -C src
  sudo make -C src install

  popd
}

install_reddit_tui() {
  pushd $PWD

  _REPO_DIR=$HOME/git/reddit-tui
  if [ -d $_REPO_DIR ]; then
    rm -rf $_REPO_DIR
    echo Removed existing directory [$_REPO_DIR]
  fi
  git clone https://github.com/tonymajestro/reddit-tui $_REPO_DIR
  cd $_REPO_DIR

  go build -o reddittui main.go
  mv -f reddittui $HOME/git/bin/

  popd
}

install_hugo() {
  pushd $PWD

  _REPO_DIR=$HOME/git/temp-hugo
  if [ -d $_REPO_DIR ]; then
    rm -rf $_REPO_DIR
    echo Removed existing directory [$_REPO_DIR]
  fi
  git clone -b master https://github.com/gohugoio/hugo $_REPO_DIR
  cd $_REPO_DIR

  go install --tags extended

  popd
}

update_protobuf_flutter() {
  dart pub global activate protoc_plugin
}

install_claude_code() {
  curl -fsSL https://claude.ai/install.sh | bash
}
